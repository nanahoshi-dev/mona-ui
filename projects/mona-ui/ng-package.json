{
    "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
    "dest": "../../dist/mona-ui",
    "allowedNonPeerDependencies": [
        "^@lucide/angular$",
        "^@mirei/ts-collections$",
        "^class-variance-authority$",
        "^culori$",
        "^d3-hierarchy$",
        "^d3-scale$",
        "^d3-shape$",
        "^luxon$",
        "^tailwind-merge$",
        "^uuid$"
    ],
    "lib": {
        "entryFile": "src/public-api.ts"
    },
    "assets": [
        {
            "input": "src/styles",
            "glob": "**/*.scss",
            "output": "styles"
        },
        {
            "input": "i18n/catalogs",
            "glob": "*.messages.json",
            "output": "i18n/catalogs"
        },
        {
            "input": "locales",
            "glob": "*/*.messages.json",
            "output": "locales"
        },
        "styles.css",
        "THIRD_PARTY_NOTICES.md"
    ]
}
