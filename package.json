{
    "private": true,
    "repository": {
        "type": "git",
        "url": "https://github.com/nanahoshi-dev/mona-ui"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "prebuild": "npm run build:metadata",
        "prewatch": "npm run build:metadata",
        "build": "npm run build:prod",
        "build:dev": "ng build mona-ui --configuration development",
        "build:prod": "ng build mona-ui --configuration production",
        "postbuild:prod": "node -e \"require('fs').globSync('dist/mona-ui/**/*.map').forEach(f=>require('fs').rmSync(f)); require('fs').rmSync('dist/mona-ui/.npmignore', {force:true})\" && npm run build:api-data && tsx projects/mona-ui-tester/scripts/generate-ai-docs.ts --package",
        "build:watch": "ng build mona-ui --watch --configuration development",
        "build:metadata": "tsx projects/mona-ui-tester/scripts/extract-metadata.ts",
        "prebuild:tester": "npm run build:api-data && npm run build:search-index && npm run generate:ai-docs",
        "build:tester": "ng build mona-ui-tester --configuration production",
        "build:api-data": "tsx projects/mona-ui-tester/scripts/generate-api-docs.ts --data",
        "build:search-index": "tsx projects/mona-ui-tester/scripts/generate-search-index.ts",
        "build:mcp": "tsx projects/mona-ui-mcp/scripts/build.ts",
        "generate:ai-docs": "tsx projects/mona-ui-tester/scripts/generate-ai-docs.ts",
        "preserve:tester": "npm run build:api-data && npm run build:search-index && npm run generate:ai-docs",
        "serve:tester": "ng serve mona-ui-tester",
        "watch": "ng build mona-ui --watch --configuration development",
        "lint": "eslint projects",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "pretest:lib": "npm run build:api-data",
        "test:lib": "ng test mona-ui --watch=false --coverage",
        "test:lib:density-bench": "tsx scripts/chart-density-memory-benchmark.ts",
        "test:lib:density-stress": "ng run mona-ui:test-density-stress --watch=false",
        "pretest:lib:watch": "npm run build:api-data",
        "test:lib:watch": "ng test mona-ui --coverage --watch",
        "test:app": "ng test mona-ui-tester --watch=false",
        "test:mcp": "vitest run --dir projects/mona-ui-mcp",
        "test:theme-colors": "tsx projects/mona-ui-tester/scripts/check-theme-color-parity.ts",
        "test:audit": "vitest run projects/mona-ui-tester/scripts/audit-i18n-rtl.spec.ts projects/mona-ui-tester/scripts/audit-locales.spec.ts projects/mona-ui-tester/scripts/check-docs-schema.spec.ts projects/mona-ui-tester/scripts/generate-ai-docs.spec.ts projects/mona-ui-tester/scripts/generate-api-docs.spec.ts projects/mona-ui-tester/scripts/generate-examples.spec.ts projects/mona-ui-tester/scripts/generate-search-index.spec.ts projects/mona-ui-tester/scripts/verify-built-package.spec.ts scripts/generate-cldr-week-data.spec.ts scripts/generate-message-parameters.spec.ts scripts/generate-locale-catalogs.spec.ts",
        "test:locales-audit": "vitest run projects/mona-ui-tester/scripts/audit-locales.spec.ts",
        "generate:cldr-week-data": "tsx scripts/generate-cldr-week-data.ts",
        "generate:locale-catalogs": "tsx scripts/generate-locale-catalogs.ts",
        "generate:message-parameters": "tsx scripts/generate-message-parameters.ts",
        "update:cldr-week-sources": "tsx scripts/generate-cldr-week-data.ts --update-sources",
        "check:cldr-week-data": "tsx scripts/generate-cldr-week-data.ts --check",
        "check:locale-catalogs": "tsx scripts/generate-locale-catalogs.ts --check",
        "check:message-parameters": "tsx scripts/generate-message-parameters.ts --check",
        "check:docs-schema": "tsx projects/mona-ui-tester/scripts/check-docs-schema.ts",
        "generate:examples": "tsx projects/mona-ui-tester/scripts/generate-examples.ts",
        "check:examples": "tsx projects/mona-ui-tester/scripts/generate-examples.ts --check",
        "generate:api-docs": "tsx projects/mona-ui-tester/scripts/generate-api-docs.ts",
        "check:api-docs": "tsx projects/mona-ui-tester/scripts/generate-api-docs.ts --check",
        "audit:locales": "tsx projects/mona-ui-tester/scripts/audit-locales.ts",
        "verify:package": "tsx projects/mona-ui-tester/scripts/verify-built-package.ts",
        "audit:i18n-rtl": "tsx projects/mona-ui-tester/scripts/audit-i18n-rtl.ts",
        "audit:i18n-rtl:strict": "tsx projects/mona-ui-tester/scripts/audit-i18n-rtl.ts --strict",
        "test:browser:forced-colors": "npm run build:tester && tsx scripts/test-forced-colors-browser.ts --no-build",
        "test:browser:forced-colors:no-build": "tsx scripts/test-forced-colors-browser.ts --no-build",
        "test:browser:geometry": "npm run build:tester && tsx scripts/test-direction-browser.ts --no-build",
        "test:browser:geometry:no-build": "tsx scripts/test-direction-browser.ts --no-build",
        "test:browser:grid": "npm run build:tester && tsx scripts/test-grid-browser.ts",
        "test:browser:grid:no-build": "tsx scripts/test-grid-browser.ts"
    },
    "workspaces": [
        "projects/*"
    ],
    "overrides": {
        "marked": "^18.2.0",
        "highlight.js": "^11.12.0"
    },
    "release": {
        "plugins": [
            [
                "@semantic-release/commit-analyzer",
                {
                    "releaseRules": [
                        {
                            "breaking": true,
                            "release": "minor"
                        }
                    ]
                }
            ],
            "@semantic-release/release-notes-generator",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": false,
                    "pkgRoot": "projects/mona-ui"
                }
            ],
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "projects/mona-ui/package.json",
                        "CHANGELOG.md"
                    ]
                }
            ],
            [
                "@semantic-release/github",
                {
                    "successComment": false,
                    "failComment": false,
                    "failTitle": false
                }
            ]
        ],
        "branches": [
            "main"
        ]
    },
    "dependencies": {
        "@angular/cdk": "^22.2.7",
        "@angular/common": "^22.2.6",
        "@angular/compiler": "^22.2.6",
        "@angular/core": "^22.2.6",
        "@angular/forms": "^22.2.6",
        "@angular/platform-browser": "^22.2.6",
        "@angular/platform-browser-dynamic": "^22.2.6",
        "@angular/router": "^22.2.6",
        "@lucide/angular": "^1.73.0",
        "@mirei/ts-collections": "^18.2.1",
        "@stackblitz/sdk": "^1.11.1",
        "@tiptap/core": "^3.34.0",
        "@tiptap/extension-highlight": "^3.34.0",
        "@tiptap/extension-image": "^3.34.0",
        "@tiptap/extension-list": "^3.34.0",
        "@tiptap/extension-subscript": "^3.34.0",
        "@tiptap/extension-superscript": "^3.34.0",
        "@tiptap/extension-table": "^3.34.0",
        "@tiptap/extension-text-align": "^3.34.0",
        "@tiptap/extension-text-style": "^3.34.0",
        "@tiptap/pm": "^3.34.0",
        "@tiptap/starter-kit": "^3.34.0",
        "class-variance-authority": "^0.7.1",
        "d3-hierarchy": "^3.1.3",
        "d3-scale": "^4.0.3",
        "d3-shape": "^3.2.1",
        "html2canvas-pro": "^2.6.4",
        "jspdf": "^4.2.1",
        "luxon": "^3.7.2",
        "remixicon": "^4.9.1",
        "rxjs": "~7.8.2",
        "svg2pdf.js": "^2.9.0",
        "tailwind-merge": "^3.7.0",
        "tslib": "^2.9.1",
        "uuid": "^14.0.3",
        "zone.js": "~0.16.3"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^22.6.0",
        "@angular-eslint/eslint-plugin": "^22.6.0",
        "@angular-eslint/eslint-plugin-template": "^22.6.0",
        "@angular-eslint/schematics": "^22.6.0",
        "@angular-eslint/template-parser": "^22.6.0",
        "@angular/build": "^22.2.7",
        "@angular/cli": "^22.2.7",
        "@angular/compiler-cli": "^22.2.6",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@tailwindcss/typography": "^0.5.20",
        "@types/culori": "^4.0.1",
        "@types/d3-hierarchy": "^3.1.7",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-shape": "^3.2.0",
        "@types/jasmine": "~7.0.0",
        "@types/luxon": "^3.7.6",
        "@types/node": "^26.6.6",
        "@typescript-eslint/eslint-plugin": "^8.72.2",
        "@typescript-eslint/parser": "^8.72.2",
        "@vitest/coverage-v8": "^5.1.0",
        "@vitest/ui": "^5.1.0",
        "angular-eslint": "^22.6.0",
        "axe-core": "^4.14.0",
        "eslint": "^10.15.0",
        "jasmine-core": "~7.0.2",
        "jsdom": "^31.0.1",
        "ng-packagr": "^22.2.6",
        "pagefind": "^1.6.0",
        "playwright": "^1.65.1",
        "prettier": "^3.10.1",
        "ts-morph": "^28.0.0",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "vitest": "^5.1.0"
    }
}
